# Copy this file to .env and adjust as needed. `.env` is gitignored.
# Every variable has a working default baked into docker-compose.yml / application.yml,
# so `docker compose up` works out of the box — override these for anything beyond local dev.

# MySQL
MYSQL_USER=academix
MYSQL_PASSWORD=academix
MYSQL_ROOT_PASSWORD=root

# JWT
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-change-me
JWT_EXPIRATION_MS=86400000

# Seeded admin account (created on first boot if no users exist yet)
ADMIN_FULL_NAME=Academix Admin
ADMIN_EMAIL=admin@academix.com
ADMIN_PASSWORD=admin12345

# Administrative-document PDF letterhead
INSTITUTION_NAME=Académix
INSTITUTION_ADDRESS=123 Avenue de l'Éducation, Tunis

# Host port the frontend is published on (http://localhost:<this>)
FRONTEND_PORT=4200
